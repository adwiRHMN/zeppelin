# Copy to .env and adjust. All values are optional defaults you can
# override per-endpoint in the GUI -- this file only seeds convenience
# fields and server config.

# Host/port the FastAPI app binds to.
APITEST_HOST=127.0.0.1
APITEST_PORT=8420

# SQLite database file (relative to repo root, or absolute).
APITEST_DB_PATH=./apitest.db

# Optional: pre-seed one endpoint on first run so you don't have to
# type it into the GUI. Leave blank to skip.
APITEST_DEFAULT_BASE_URL=http://localhost:3000
APITEST_DEFAULT_ADAPTER=openai_compat
APITEST_DEFAULT_API_KEY=
APITEST_DEFAULT_MODEL=
