# Copy to .env.local for local dev, or let `vercel env pull .env.local`
# populate it after attaching a Neon/Postgres store to the Vercel project.

# Connection string for the Neon/Postgres database. Vercel's Neon
# Marketplace integration injects this as DATABASE_URL automatically in
# deployed environments; POSTGRES_URL is accepted too for compatibility
# with the older Vercel Postgres integration.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
